# ── Приложение ───────────────────────────────────────────────────────────────
APP_ID=forum-app
# Домен фронтенда (без протокола) — используется в CORS на бэкенде
DOMAIN=localhost

# ── Backend порт ─────────────────────────────────────────────────────────────
PORT=3001
BACKEND_PORT=3001

# ── Frontend порт ────────────────────────────────────────────────────────────
FRONTEND_PORT=3000

# ── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_USER=forum
POSTGRES_PASSWORD=change_me_db_password
POSTGRES_DB=forum

# ── MinIO ────────────────────────────────────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me_minio_password
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# Публичный URL MinIO (по которому браузер скачивает файлы/аватары).
# Для локальной разработки — localhost; для прода — ваш домен/CDN.
STORAGE_PUBLIC_ENDPOINT=http://localhost:9000

# ── JWT ──────────────────────────────────────────────────────────────────────
JWT_ACCESS_TIME=900
# Минимум 32 символа, случайная строка
JWT_REFRESH_SECRET=change_me_jwt_refresh_secret_at_least_32_chars
JWT_REFRESH_TIME=604800
REFRESH_COOKIE=refreshToken
# Минимум 32 символа, случайная строка
COOKIE_SECRET=change_me_cookie_secret_at_least_32_chars

# ── Загрузка файлов ──────────────────────────────────────────────────────────
UPLOAD_MAX_FILE_SIZE=52428800
UPLOAD_MAX_FILES=10

# ── CORS ─────────────────────────────────────────────────────────────────────
# Полный URL фронтенда с протоколом и портом (доступный браузеру)
# Локально: http://localhost:3000 | На сервере: https://yourdomain.com
CORS_ORIGIN=http://localhost:3000

# ── Frontend GraphQL URL ─────────────────────────────────────────────────────
# Значение запекается в JS-бандл при сборке — должен быть публичным URL,
# доступным из браузера пользователя.
#
# Локально:  http://localhost:3001/api/graphql
# На сервере: https://api.yourdomain.com/api/graphql
GRAPHQL_URL=http://localhost:3001/api/graphql
